{
  "name": "dxd-chargen",
  "version": "0.147.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/stop-local.mjs",
    "dev": "next dev --turbopack",
    "local": "node scripts/run-local.mjs",
    "build": "next build",
    "prestart": "node scripts/stop-local.mjs",
    "start": "next start",
    "stop": "node scripts/stop-local.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.mjs",
    "check": "npm run validate:data && npm run typecheck && npm run build",
    "test:db": "node --conditions=react-server --test scripts/database-harness.test.mjs",
    "db:generate": "auth generate --config scripts/config/auth-schema.ts --adapter drizzle --dialect sqlite --output src/server/db/auth-schema.ts --yes && drizzle-kit generate",
    "test:db:bundle": "node scripts/database-bundle.mjs",
    "test:accounts": "node --conditions=react-server --test scripts/account-lifecycle.test.mjs scripts/security-journal.test.mjs scripts/mail-delivery.test.mjs scripts/account-rate-limit.test.mjs scripts/site-admin-review.test.mjs scripts/access-policy.test.mjs scripts/authorization-context.test.mjs scripts/character-service.test.mjs scripts/campaign-service.test.mjs scripts/campaign-invitation.test.mjs",
    "test:legacy-api-boundary": "node --test scripts/legacy-api-boundary.test.mjs",
    "install:browser:chromium": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium --only-shell",
    "test:browser:account-campaigns": "node scripts/workspace-account-campaigns.browser.mjs",
    "test:browser:account-live": "node --conditions=react-server scripts/workspace-account-live.browser.mjs",
    "maintenance:local": "node scripts/local-maintenance.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "accounts:check:local": "node scripts/check-local-runtime.mjs",
    "accounts:dev": "node scripts/run-accounts-local.mjs",
    "accounts:mail:local": "node --conditions=react-server --import ./scripts/test-typescript-loader.mjs scripts/local-auth-mail.mjs",
    "accounts:bootstrap-admin:local": "node --conditions=react-server --import ./scripts/test-typescript-loader.mjs scripts/bootstrap-site-admin.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^0.575.0",
    "next": "^16.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^6.2.3",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "playwright": "^1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
