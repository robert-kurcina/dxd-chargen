# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*

# firebase
firebase-debug.log
firestore-debug.log

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows metadata
Thumbs.db
Desktop.ini

# Editor / IDE working files
.vscode/
.idea/
*.swp
*.swo
*~
*.tmp

# Microsoft Office temporary / lock files
~$*.docx
~$*.xlsx
~$*.pptx

# Python caches / local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node / npm local dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment / secrets
.env
.env.*
!.env.example

# Test / coverage scratch
coverage/
.nyc_output/

# Local scratch / patch artifacts
*.bak
*.orig
*.rej

